     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(http_request_duration_seconds_count{status=~\"5..\"}[10s])) / sum(rate(http_request_duration_seconds_count[10s])) or vector(0)",

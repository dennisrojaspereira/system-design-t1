  {
   "type": "timeseries",
   "title": "Requisições por segundo, por status",
   "id": 9,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "302 = redirect ok · 201 = link criado · 404 = não achou · 503 = aplicação sem conseguir falar com o banco.",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 6
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",

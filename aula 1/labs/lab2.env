# Lab 2 — Geração de IDs. Troque ID_STRATEGY e CODE_LENGTH e rode `make apply`.
#   counter : sequência central no banco + base62
#   random  : código aleatório de CODE_LENGTH caracteres (colide quando o espaço enche)
#   range   : cada instância reserva blocos de 1000 IDs
ID_STRATEGY=random
CODE_LENGTH=3
CACHE_ENABLED=false
ANALYTICS_MODE=off
DB_POOL_MAX=10

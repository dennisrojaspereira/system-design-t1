# Lab 5 — Banco de dados: leituras na réplica, escritas no primário.
COMPOSE_PROFILES=ha,replica
TARGET=http://lb
DATABASE_REPLICA_URL=postgres://shortener:shortener@pg-replica:5432/shortener
# Atraso proposital na réplica para o lag ficar visível. Em produção ele varia sozinho.
REPLICA_APPLY_DELAY=2s
ID_STRATEGY=range
# Comece sem cache para ver o problema; depois ligue (true) e rode `make apply`.
CACHE_ENABLED=false
REDIS_TIMEOUT_MS=50
ANALYTICS_MODE=off
DB_POOL_MAX=10

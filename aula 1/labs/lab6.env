# Lab 6 — Analytics: contar cliques sem derrubar o redirect.
COMPOSE_PROFILES=ha
TARGET=http://lb
ID_STRATEGY=range
CACHE_ENABLED=true
REDIS_TIMEOUT_MS=50
# sync  : UPDATE no primário a cada clique (ingênuo)
# async : fila em memória + um lote por segundo numa tabela de eventos
ANALYTICS_MODE=sync
DB_POOL_MAX=10

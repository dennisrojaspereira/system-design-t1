# Lab 4 — CDN, cache e acesso privado.
# A origem fica "em outro continente": cada MISS custa 850 ms.
ORIGIN_LATENCY_MS=850
# path = todos os alunos compartilham a mesma entrada de cache.
# path+cookie = cada sessão abre a sua (o erro clássico ao adicionar autenticação).
CACHE_KEY=path
CACHE_MAX_MB=512
WORKERS=1

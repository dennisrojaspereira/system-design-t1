  {
   "type": "row",
   "title": "Visão geral — os SLOs da jornada",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   }
  },
  {
   "type": "stat",
   "title": "Primeiro quadro p95",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Clique no play até o primeiro quadro, medido no player. SLO da aula: p95 < 2,5 s.",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(player_startup_seconds_bucket[2m])))",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 2
       },
       {
        "color": "red",
        "value": 2.5
       }
      ]
     },
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "Rebuffer ratio",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Segundos travado / (segundos reproduzidos + travado).",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(player_stall_seconds_total[1m])) / (sum(rate(player_watched_seconds_total[1m])) + sum(rate(player_stall_seconds_total[1m])))",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.01
       },
       {
        "color": "red",
        "value": 0.05
       }
      ]
     },
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "Hit ratio da borda",
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Segmentos servidos do cache da borda, por requisição.",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 8,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(edge_requests_total{cache=\"HIT\",kind=\"segment\"}[30s])) / sum(rate(edge_requests_total{cache=~\"HIT|MISS\",kind=\"segment\"}[30s]))",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.5
       },
       {
        "color": "green",
        "value": 0.9
       }
      ]
     },
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",

   "id": 9,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Se 'na fila' cresce enquanto o encode leva o mesmo tempo, faltam slots.",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 6
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(queue_jobs{state=\"QUEUED\"})",
